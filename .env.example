# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Instagram Credentials (for Instaloader scraping) ────────────────────────
# If these are left empty the app will run in DEMO MODE (manual feature input).
INSTA_USERNAME=your_instagram_username
INSTA_PASSWORD=your_instagram_password

# ── Apify Token (reliable Instagram scraping via Apify) ─────────────────────
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_api_token_here

# ── RapidAPI Key (instagram120 API) ─────────────────────────────────────────
# Subscribe at https://rapidapi.com/hub and copy your key here.
RAPIDAPI_KEY=your_rapidapi_key_here

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS / Frontend Origin ───────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── SMTP Email (for OTP / password-reset emails) ────────────────────────────
# Recommended: use a Gmail App Password (NOT your real password).
# See: https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER=InstaGuard Security <your_email@gmail.com>
