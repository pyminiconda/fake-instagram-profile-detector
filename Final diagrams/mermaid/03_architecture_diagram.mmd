flowchart TD
    %% Styling
    classDef presentation fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000
    classDef business fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000
    classDef ml fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000
    classDef data fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000
    classDef external fill:#ffffff,stroke:#000000,stroke-width:2px,stroke-dasharray: 5 5,color:#000000

    User([User / Admin])

    subgraph Presentation_Layer [1. Presentation Layer - Streamlit UI]
        AuthUI[Auth UI]
        DashboardUI[Dashboard UI]
        BatchUI[Batch Analysis UI]
        AdminUI[Admin Tools UI]
    end

    subgraph Business_Layer [2. Business Logic Layer - Core Services]
        direction LR
        ProfFetch[Profile Fetcher]
        FeatureExt[Feature Extractor]
        PredEngine[Prediction Engine]
        HistMgr[History Manager]
        RepGen[Report Generator]
    end

    subgraph ML_Layer [3. Machine Learning Pipeline]
        direction LR
        Preprocess[Data Preprocessor]
        Trainer[Model Trainer]
        Evaluator[Model Evaluator]
    end

    subgraph Data_Layer [4. Data & External Integration Layer]
        direction LR
        DB[(SQLite app.db)]
        ModelStore[[.pkl Model Storage]]
        Dataset[[CSV Datasets]]
    end

    ExtAPI{{External Scraping APIs}}:::external

    %% Connections
    User -->|Interacts| AuthUI
    AuthUI --> HistMgr
    DashboardUI --> ProfFetch
    DashboardUI --> PredEngine
    DashboardUI --> RepGen
    BatchUI --> PredEngine
    AdminUI --> Preprocess

    ProfFetch -->|Raw Data| FeatureExt
    FeatureExt -->|Engineered Features| PredEngine
    PredEngine -->|Results| HistMgr
    HistMgr -->|History Data| RepGen

    Preprocess --> Trainer
    Evaluator --> Trainer

    HistMgr -->|SQL Read/Write| DB
    ProfFetch -.->|HTTP Requests| ExtAPI
    Trainer -->|Saves| ModelStore
    PredEngine -->|Loads| ModelStore
    Trainer -->|Reads| Dataset

    %% Apply Classes
    class AuthUI,DashboardUI,BatchUI,AdminUI presentation
    class ProfFetch,FeatureExt,PredEngine,HistMgr,RepGen business
    class Preprocess,Trainer,Evaluator ml
    class DB,ModelStore,Dataset data