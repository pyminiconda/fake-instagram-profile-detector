classDiagram
    %% Styling
    classDef default fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000

    class PredictionEngine {
        +Object model
        +Object scaler
        +Object explainer
        -load() : void
        +is_ready() : bool
        +predict(raw_features: list) : dict
        -compute_shap(X_scaled) : dict
        -assess_risk(raw_features) : dict
    }

    class DataManager {
        +DataFrame df
        +String label_col
        +load_dataset() : DataFrame
        +get_info() : dict
        +clean() : DataFrame
        +split() : tuple
    }

    class ModelTrainer {
        +dict models
        +dict cv_results
        +train_all() : dict
        +tune_best() : tuple
        +get_all_models() : dict
    }

    class ModelEvaluator {
        +dict metrics
        +Object best_model
        +evaluate_all() : dict
        +select_best() : str
        +save_best_model() : str
        +plot_roc_curves() : void
    }
