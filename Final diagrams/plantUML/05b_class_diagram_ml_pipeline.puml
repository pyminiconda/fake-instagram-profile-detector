@startuml
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam BackgroundColor White
hide empty members

class PredictionEngine {
    +model: object
    +scaler: object
    +explainer: object
    -load(): void
    +is_ready(): bool
    +predict(raw_features: list): dict
    -compute_shap(X_scaled): dict
    -assess_risk(raw_features): dict
}

class DataManager {
    +df: DataFrame
    +label_col: str
    +load_dataset(): DataFrame
    +get_info(): dict
    +clean(): DataFrame
    +split(): tuple
}

class ModelTrainer {
    +models: dict
    +cv_results: dict
    +train_all(): dict
    +tune_best(): tuple
    +get_all_models(): dict
}

class ModelEvaluator {
    +metrics: dict
    +best_model: object
    +evaluate_all(): dict
    +select_best(): str
    +save_best_model(): str
    +plot_roc_curves(): void
}

@enduml
