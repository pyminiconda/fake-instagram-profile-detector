@startuml
' ══════════════════════════════════════════════════
' UML Communication (Collaboration) Diagram
' Fake Instagram Profile Detection System
' Scenario: Single Profile Analysis Flow
' ══════════════════════════════════════════════════

skinparam BackgroundColor White
skinparam defaultFontName Arial

skinparam participant {
    BackgroundColor White
    BorderColor Black
}

' ── Actor ──
actor ":User" as User

' ── Objects (objectName : ClassName) ──
participant ":DashboardUI" as UI
participant ":ProfileFetcher" as Fetcher
participant ":FeatureExtractor" as Extractor
participant ":PredictionEngine" as Predictor
participant ":HistoryManager" as HistMgr
participant ":ReportGenerator" as RepGen
participant ":DatabaseManager" as DB
participant ":ExternalAPI" as ExtAPI

' ══════════════════════════════════════════════════
' Links with Numbered Messages
' Decimal nested numbering shows call hierarchy
' ══════════════════════════════════════════════════

User --> UI : 1: analyzeProfile(username)

UI --> Fetcher : 1.1: fetch_profile(username)
Fetcher --> ExtAPI : 1.1.1: HTTP GET /profile
ExtAPI --> Fetcher : 1.1.1: return JSON
Fetcher --> DB : 1.1.2: cache_profile(data)
Fetcher --> UI : 1.1: return profileData

UI --> Extractor : 1.2: extract_from_profile(data)
Extractor --> UI : 1.2: return featureVector

UI --> Predictor : 1.3: predict(features)
Predictor --> UI : 1.3: return prediction

UI --> HistMgr : 1.4: save_result(prediction)
HistMgr --> DB : 1.4.1: save_search(result)
DB --> HistMgr : 1.4.1: return historyId

UI --> RepGen : 1.5 *[opt]: generate_single_report()
RepGen --> UI : 1.5: return pdfBytes

@enduml
