@startuml
skinparam BackgroundColor White
skinparam componentStyle rectangle

rectangle "User / Admin" as User
usecase "0.0\nFake Instagram\nDetector System" as System
rectangle "External APIs\n(Apify/RapidAPI)" as ExtAPI
database "D1: SQLite Database" as DB
database "D2: File System\n(.pkl / .csv)" as FS

User --> System : "Instagram Username,\nCSV Datasets"
System --> User : "Prediction Results,\nPDF Reports"
System <--> ExtAPI : "HTTP Requests /\nJSON Responses"
System <--> DB : "Store / Retrieve\nAnalysis History"
System <--> FS : "Load Models,\nRead Data"

@enduml
