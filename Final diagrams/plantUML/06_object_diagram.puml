@startuml
skinparam object {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam BackgroundColor White

object "db : DatabaseManager" as db {
    db_path = "app.db"
}

object "prediction_engine : PredictionEngine" as engine {
    model = <XGBClassifier>
    scaler = <StandardScaler>
    explainer = <TreeExplainer>
}

object "profile_fetcher : ProfileFetcher" as fetcher {
    demo_mode = False
    apify_token = env("APIFY_TOKEN")
    rapidapi_key = env("RAPIDAPI_KEY")
}

object "history_manager : HistoryManager" as history

fetcher --> db : db
history --> db : db

@enduml
