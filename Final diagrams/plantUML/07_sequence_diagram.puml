@startuml
skinparam sequenceMessageAlign center
skinparam BackgroundColor White
skinparam NoteBackgroundColor White

actor "User" as User
participant "Dashboard UI" as UI
participant "Profile Fetcher" as Fetcher
participant "Feature Extractor" as Extractor
participant "Prediction Engine" as Predictor
participant "History Manager" as DB
participant "Report Generator" as Report

autonumber

User -> UI : Enter Instagram Username
activate UI

UI -> Fetcher : fetch_profile(username)
activate Fetcher
Fetcher -> Fetcher : Fetch from External APIs (Apify/RapidAPI)
Fetcher --> UI : Raw Profile Data JSON
deactivate Fetcher

UI -> Extractor : extract_features(raw_data)
activate Extractor
Extractor --> UI : Engineered Features (DataFrame)
deactivate Extractor

UI -> Predictor : predict(features)
activate Predictor
Predictor -> Predictor : Load Model (.pkl) & Scaler
Predictor -> Predictor : Compute Risk Score & SHAP
Predictor --> UI : Prediction Result (Fake/Real)
deactivate Predictor

UI -> DB : save_analysis_history(result)
activate DB
DB -> DB : INSERT INTO ANALYSIS_HISTORY
DB --> UI : Confirm Save
deactivate DB

opt Generate PDF Report
    UI -> Report : generate_single_report(result)
    activate Report
    Report --> UI : PDF Document
    deactivate Report
    UI --> User : Download PDF
end

UI --> User : Display Results & Risk Score
deactivate UI

@enduml
